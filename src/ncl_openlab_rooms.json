{
  "schema_version": 1,
  "_comment": "NCL OPEN LAB 房型設定。新增房型優先只改這個檔案；流程(flow)代表DOM操作模型，同流程的房型共用同一份引擎與測試。templates 供同類設備共用欄位（extends）。 categories 專供二層導覽；ONLINE_CANDIDATE 不是已核實可提交。slots_verified=false 表示模板時段是草稿，不可呈現在正式 GUI。",
  "flows": {
    "block_slot": {
      "description": "多小時區塊時段：.time-box2；點選前必須帶 book class，選取後以 selected 表示。",
      "slot_selector": ".time-box2[data-param1]",
      "slot_requires_book_class": true,
      "book_class_marks_selected": false
    },
    "hourly_slot": {
      "description": "整點一小時時段：.time-box；未選取時可直接點選，選取後才出現 book class。",
      "slot_selector": ".time-box[data-param1]",
      "slot_requires_book_class": false,
      "book_class_marks_selected": true
    }
  },
  "templates": {
    "equipment_1h": {
      "entry_label": "創藝手作坊縫紉機",
      "flow": "hourly_slot",
      "slots": {
        "kind": "hourly",
        "start": 9,
        "end": 20
      },
      "default_all_slots": false,
      "single_slot_option": true,
      "submit_requires_ack": true,
      "evidence": {
        "live": "NOT_VERIFIED",
        "live_notes": "2026-11-04 實機盤點：房型方塊與 .time-box[data-param1] 的 11 個一小時時段（僅縫紉機01 觀察到時段）。設備類別「創藝手作坊縫紉機」取自使用者截圖，9 台設備出現在同一個日期頁推得屬同類別，點擊進入與最後確認頁用字、成交皆未驗證；確認頁比對採房名且不符即不送出。",
        "source": "ncl_reports/ncl_inventory_20261104_144349.json"
      },
      "slots_verified": false
    }
  },
  "rooms": {
    "music": {
      "label": "音樂創作室",
      "ui_label": "音樂創作室（3 小時）",
      "entry_label": "音樂創作室",
